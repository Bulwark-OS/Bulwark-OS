<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <n>disposable</n>
  <title>Disposable AppVM</title>
  <description>Ephemeral VM. The disk image is reset from a clean snapshot on every boot. Nothing persists after shutdown.</description>

  <memory unit='MiB'>2048</memory>
  <currentMemory unit='MiB'>2048</currentMemory>
  <vcpu placement='static'>2</vcpu>

  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
  </os>

  <features>
    <acpi/>
    <apic/>
  </features>

  <cpu mode='host-passthrough' check='none' migratable='off'/>

  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>

  <!--
    IMPORTANT: on_poweroff=destroy ensures the domain is fully removed from
    memory. The bulwarkos-disposable-reset.service systemd unit resets the
    disk image back to the clean snapshot before the next launch.
  -->
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <on_crash>destroy</on_crash>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!--
      The disposable VM boots from a read-only backing file.
      The overlay qcow2 captures all writes and is deleted on shutdown
      by bulwarkos-disposable-reset.service.
    -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <!-- This overlay is regenerated fresh from the base image on each boot -->
      <source file='/var/lib/bulwarkos/images/disposable-overlay.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <boot order='1'/>
    </disk>

    <!-- Network via firewall — intentionally no LAN access beyond HTTP/HTTPS -->
    <interface type='network'>
      <source network='bulwark-appvms'/>
      <model type='virtio'/>
    </interface>

    <graphics type='spice' autoport='yes'>
      <listen type='none'/>
      <image compression='off'/>
      <!-- No clipboard — nothing should leave this VM -->
      <clipboard copypaste='no'/>
    </graphics>

    <video>
      <model type='virtio' heads='1' primary='yes'>
        <acceleration accel3d='no'/>
      </model>
    </video>

    <input type='tablet' bus='usb'/>
    <input type='keyboard' bus='virtio'/>

    <memballoon model='virtio'>
      <stats period='5'/>
    </memballoon>

    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>

    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
