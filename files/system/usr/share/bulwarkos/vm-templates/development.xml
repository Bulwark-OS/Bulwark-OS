<domain type='kvm'>
  <n>development</n>
  <title>BulwarkOS — Development AppVM</title>
  <description>VM for compilers, containers, and local development servers. Higher resource allocation.</description>

  <memory unit='MiB'>16384</memory>
  <currentMemory unit='MiB'>8192</currentMemory>
  <vcpu placement='static'>8</vcpu>

  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <!-- Allow nested virtualisation for running containers inside the VM -->
    <vmx state='on'/>
  </features>

  <cpu mode='host-passthrough' check='none' migratable='off'>
    <!-- Expose CPU topology for better container scheduling -->
    <topology sockets='1' dies='1' cores='4' threads='2'/>
  </cpu>

  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- Larger boot disk for dev tooling -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <source file='/var/lib/bulwarkos/images/development.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <boot order='1'/>
    </disk>

    <interface type='network'>
      <source network='bulwark-appvms'/>
      <model type='virtio'/>
    </interface>

    <graphics type='spice' autoport='yes'>
      <listen type='none'/>
      <image compression='off'/>
    </graphics>

    <video>
      <model type='virtio' heads='1' primary='yes'>
        <acceleration accel3d='yes'/>
      </model>
    </video>

    <channel type='spiceport'>
      <target type='virtio' name='com.redhat.spice.0'/>
    </channel>

    <input type='tablet' bus='usb'/>
    <input type='keyboard' bus='virtio'/>

    <memballoon model='virtio'>
      <stats period='5'/>
    </memballoon>

    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>

    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
