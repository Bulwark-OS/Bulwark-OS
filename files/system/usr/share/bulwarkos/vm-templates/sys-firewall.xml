<domain type='kvm'>
  <name>sys-firewall</name>
  <title>BulwarkOS sys-firewall — traffic routing and policy VM</title>
  <description>Routes and filters traffic between sys-net and AppVMs via nftables. Never exposes physical NICs directly.</description>

  <memory unit='MiB'>512</memory>
  <currentMemory unit='MiB'>512</currentMemory>
  <vcpu placement='static'>2</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <!-- Explicit non-Secure-Boot OVMF. firmware='efi' on Fedora auto-selects
         OVMF_CODE.secboot.fd which blocks unsigned images such as Alpine. -->
    <loader readonly='yes' type='pflash'>/usr/share/edk2/ovmf/OVMF_CODE.fd</loader>
    <nvram template='/usr/share/edk2/ovmf/OVMF_VARS.fd'/>
  </os>

  <features>
    <acpi/>
    <apic/>
  </features>

  <cpu mode='host-passthrough' check='none' migratable='off'/>

  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!--
      Primary boot disk — thin qcow2 overlay on the pre-installed
      Alpine Cloud base image. Boots directly into Alpine; no installer
      step required.
    -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <source file='/var/lib/bulwarkos/images/sys-firewall.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <boot order='2'/>
    </disk>

    <!--
      cloud-init NoCloud seed ISO. cloud-init scans block devices for
      a device with volume label 'cidata' and reads user-data/meta-data
      from it on first boot to configure hostname, nftables, IP forwarding.
      This is NOT a bootable image — it is a data carrier only.
      Once cloud-init has run, this cdrom can be detached.
    -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/bulwarkos/images/sys-firewall-cloud-init.iso'/>
      <target dev='sda' bus='sata'/>
      <boot order='1'/>
      <readonly/>
    </disk>

    <interface type='network'>
      <source network='bulwark-internal'/>
      <model type='virtio'/>
      <alias name='uplink'/>
    </interface>

    <!-- Downlink to AppVMs (isolated network) -->
    <interface type='network'>
      <source network='bulwark-appvms'/>
      <model type='virtio'/>
      <alias name='appvm-downlink'/>
    </interface>
    
    
    <graphics type='spice' autoport='yes'>
      <listen type='address' address='127.0.0.1'/>
      <image compression='off'/>
    </graphics>

    <video>
      <model type='qxl' ram='65536' vram='65536' vgamem='16384' heads='1' primary='yes'/>
    </video>

    <channel type='spicevmc'>
      <target type='virtio' name='com.redhat.spice.0'/>
    </channel>

    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>

    <memballoon model='virtio'>
      <stats period='5'/>
    </memballoon>

  </devices>
</domain>
