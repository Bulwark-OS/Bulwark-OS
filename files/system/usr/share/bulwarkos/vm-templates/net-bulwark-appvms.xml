<network>
  <n>bulwark-appvms</n>
  <uuid><!-- generated by libvirt --></uuid>

  <!--
    Isolated AppVM bridge. sys-firewall connects here as its LAN-side
    interface and provides DHCP + NAT-via-sys-net for all AppVMs.
    The host does not participate — no NAT from libvirt itself.
  -->

  <bridge name='bulwark-avm' stp='off' delay='0'/>

  <!-- Completely isolated — no host forwarding, no libvirt NAT -->
  <forward mode='none'/>

  <!--
    RFC 1918 /24. DHCP is intentionally omitted here because
    sys-firewall runs its own dnsmasq inside the VM and hands out
    addresses to AppVMs. The host-side IP is a dummy anchor only.
  -->
  <ip address='10.10.1.1' netmask='255.255.255.0'/>
</network>
