<network>
  <name>bulwark-internal</name>
  <uuid><!-- generated by libvirt --></uuid>
  <!--
    Internal-only bridge between sys-net and sys-firewall.
    No DHCP, no DNS, no NAT — sys-net provides those upstream.
    sys-firewall connects here as its WAN-side interface.
  -->

  <bridge name='bulwark-int' stp='off' delay='0'/>

  <!--
    forward mode='none' since this is a completely isolated bridge.
    The host itself does not participate in this network.
  -->
  <forward mode='none'/>
  <!-- Static /30 — only two hosts: sys-net and sys-firewall -->
</network>
