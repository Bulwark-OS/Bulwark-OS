[Unit]
Description=BulwarkOS First-Run Setup Wizard
# Only run if setup has not been completed yet
ConditionPathExists=/var/lib/bulwarkos/.setup-complete
# Wait for the graphical session to be ready
After=graphical-session.target
Requires=graphical-session.target

[Service]
Type=simple
# Run as the logged-in user (this is a user unit)
ExecStart=/usr/bin/python3 -m bulwarkos_wizard
# Disable itself after a successful exit (exit code 0)
ExecStartPost=/bin/systemctl --user disable bulwarkos-setup.service
# If the wizard crashes, don't loop — let the user re-run manually
Restart=no
# Give the wizard 30 minutes max before force-killing
TimeoutStopSec=1800
# Ensure the wizard has a valid display
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=graphical-session.target
