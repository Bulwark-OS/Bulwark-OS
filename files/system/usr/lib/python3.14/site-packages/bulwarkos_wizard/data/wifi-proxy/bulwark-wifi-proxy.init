#!/sbin/openrc-run
# OpenRC init script for bulwark-wifi-proxy
# Manages the BulwarkOS WiFi proxy daemon inside sys-net.
# Injected by the BulwarkOS wizard via cloud-init write_files.

name="bulwark-wifi-proxy"
description="BulwarkOS WiFi proxy — bridges iwd to host via virtio-serial"

command="/usr/bin/python3"
command_args="/usr/local/bin/bulwark-wifi-proxy"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/bulwark-wifi-proxy.log"
error_log="/var/log/bulwark-wifi-proxy.log"

depend() {
    need iwd
    after net
}
